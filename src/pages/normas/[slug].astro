---
import '../../styles/global.css';
import normas from '../../../data/normas/catalogo.json';

export function getStaticPaths() {
  return normas.map((norma) => ({
    params: { slug: norma.slug },
    props: { norma }
  }));
}

const { norma } = Astro.props;
const historialCurado = norma.historial ?? [];
const numeroCambios = historialCurado.filter((item) => item.tipo === 'Modificación').length;
const tieneHistorialCurado = historialCurado.length > 0;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`Ficha normativa de ${norma.titulo}. Historial, fuentes oficiales y seguimiento de modificaciones.`}
    />
    <meta name="theme-color" content="#002028" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{norma.siglas} · Observatorio Normativo Universitario</title>
  </head>

  <body>
    <header>
      <div class="institutional-bar">
        <div class="container institutional-bar__inner">
          <a
            class="umu-brand"
            href="https://www.um.es/"
            target="_blank"
            rel="noreferrer"
            aria-label="Universidad de Murcia"
          >
            <img src="/assets/logo-umu.png" alt="Universidad de Murcia" />
          </a>

          <div class="institutional-context">
            <span>Consejo de Estudiantes</span>
            <strong>Vicepresidencia de Normativa y Calidad</strong>
          </div>
        </div>
      </div>

      <div class="detail-hero">
        <div class="container">
          <nav class="breadcrumb" aria-label="Migas de pan">
            <a href="/">Observatorio</a>
            <span aria-hidden="true">/</span>
            <a href="/#catalogo">Catálogo</a>
            <span aria-hidden="true">/</span>
            <span>{norma.siglas}</span>
          </nav>

          <div class="detail-hero__grid">
            <div>
              <div class="detail-kickers">
                <span class="detail-badge">{norma.ambito}</span>
                <span class="detail-verified">
                  <span aria-hidden="true"></span>
                  {norma.verificacion}
                </span>
              </div>

              <p class="eyebrow eyebrow--light">{norma.siglas} · {norma.id}</p>
              <h1 class="detail-title">{norma.titulo}</h1>
              <p class="detail-lead">{norma.descripcion}</p>
            </div>

            <aside class="detail-status">
              <p>Estado jurídico</p>
              <strong>{norma.estado}</strong>
              <dl>
                <div>
                  <dt>{norma.actualizacion_label ?? 'Última actualización'}</dt>
                  <dd>{norma.ultima_actualizacion}</dd>
                </div>
                <div>
                  <dt>Última verificación</dt>
                  <dd>{norma.fecha_verificacion}</dd>
                </div>
              </dl>
            </aside>
          </div>
        </div>
      </div>
    </header>

    <main>
      <div class="container detail-layout">
        <aside class="detail-sidebar">
          <nav class="detail-nav" aria-label="Contenido de la ficha">
            <p>En esta ficha</p>
            <a href="#datos">Datos básicos</a>
            <a href="#materias">Materias</a>
            <a href="#historial">Historial normativo</a>
            {norma.cambios_automaticos?.length > 0 && <a href="#detecciones">Detecciones automáticas</a>}
            <a href="#fuentes">Fuentes oficiales</a>
            <a href="#seguimiento">Seguimiento</a>
          </nav>

          <a class="back-link" href="/#catalogo">← Volver al catálogo</a>
        </aside>

        <div class="detail-content">
          <section class="detail-section detail-intro" id="datos">
            <div class="detail-section__heading">
              <p class="eyebrow">FICHA NORMATIVA</p>
              <h2>Datos básicos</h2>
            </div>

            <div class="metadata-grid">
              <div>
                <span>Referencia</span>
                <strong>{norma.id}</strong>
              </div>
              <div>
                <span>Tipo</span>
                <strong>{norma.tipo}</strong>
              </div>
              <div>
                <span>Publicación</span>
                <strong>{norma.publicacion}</strong>
              </div>
              <div>
                <span>{norma.fuente}</span>
                <strong>
                  Núm. {norma.boletin_numero ?? norma.boe_numero}
                  {norma.publicacion_numero ? ` · Pub. ${norma.publicacion_numero}` : ''}
                </strong>
              </div>
              {norma.entrada_vigor && (
                <div>
                  <span>Entrada en vigor</span>
                  <strong>{norma.entrada_vigor}</strong>
                </div>
              )}
              <div>
                <span>Departamento / órgano</span>
                <strong>{norma.departamento}</strong>
              </div>
              {norma.nivel_interno && (
                <div>
                  <span>Nivel interno</span>
                  <strong>{norma.nivel_interno}</strong>
                </div>
              )}
              {norma.centro && (
                <div>
                  <span>Centro</span>
                  <strong>{norma.centro}</strong>
                </div>
              )}
            </div>
          </section>

          <section class="detail-section" id="materias">
            <div class="detail-section__heading">
              <p class="eyebrow">CLASIFICACIÓN</p>
              <h2>Materias</h2>
            </div>

            <div class="detail-matters">
              {norma.materias.map((materia) => <span>{materia}</span>)}
            </div>
          </section>

          {norma.alerta_tramitacion && (
            <section class="detail-section">
              <div class="legislative-alert">
                <div>
                  <p class="eyebrow eyebrow--red">NORMA EN TRAMITACIÓN</p>
                  <h2>{norma.alerta_tramitacion.titulo}</h2>
                  <p>{norma.alerta_tramitacion.descripcion}</p>
                  <span>Última actualización oficial: {norma.alerta_tramitacion.fecha_actualizacion}</span>
                </div>
                <a href={norma.alerta_tramitacion.url} target="_blank" rel="noreferrer">
                  Consultar tramitación oficial ↗
                </a>
              </div>
            </section>
          )}

          <section class="detail-section" id="historial">
            <div class="detail-section__heading detail-section__heading--split">
              <div>
                <p class="eyebrow">TRAZABILIDAD</p>
                <h2>Historial normativo</h2>
              </div>

              <div class="history-count">
                {tieneHistorialCurado ? (
                  <>
                    <strong>{numeroCambios}</strong>
                    <span>{numeroCambios === 1 ? 'modificación' : 'modificaciones'} expresas en el historial curado</span>
                  </>
                ) : (
                  <>
                    <strong>—</strong>
                    <span>histórico previo pendiente de incorporación</span>
                  </>
                )}
              </div>
            </div>

            <div class="scope-note">
              <strong>Alcance del historial</strong>
              <p>{norma.alcance_historial}</p>
            </div>

            {tieneHistorialCurado ? (
              <ol class="timeline">
                {historialCurado.map((item) => (
                  <li class="timeline-item">
                    <div class="timeline-marker" aria-hidden="true"></div>

                    <div class="timeline-date">
                      <strong>{item.fecha}</strong>
                      <span class={`event-type event-type--${item.tipo.toLowerCase()}`}>
                        {item.tipo}
                      </span>
                    </div>

                    <article class="timeline-card">
                      <h3>{item.titulo}</h3>
                      <p>{item.descripcion}</p>

                      {item.afecta.length > 0 && (
                        <div class="affected-blocks">
                          <span>Afecta a</span>
                          <div>
                            {item.afecta.map((bloque) => <strong>{bloque}</strong>)}
                          </div>
                        </div>
                      )}

                      <div class="timeline-meta">
                        {item.entrada_vigor && (
                          <span>En vigor desde {item.entrada_vigor}</span>
                        )}

                        {item.norma_modificadora && (
                          <span>{item.norma_modificadora}</span>
                        )}
                      </div>

                      <a
                        class="official-inline-link"
                        href={item.url}
                        target="_blank"
                        rel="noreferrer"
                      >
                        Consultar en {norma.fuente}
                        <span aria-hidden="true">↗</span>
                      </a>
                    </article>
                  </li>
                ))}
              </ol>
            ) : (
              <div class="history-pending">
                <strong>Histórico anterior aún no incorporado manualmente</strong>
                <p>
                  {norma.fuente === 'BOE'
                    ? 'La norma está incluida en la vigilancia automática del BOE. El monitor compara las nuevas versiones textuales publicadas desde su línea base.'
                    : 'La norma está incluida en la vigilancia diaria del BORM. Las nuevas publicaciones potencialmente relacionadas se detectan automáticamente y quedan pendientes de revisión humana antes de incorporarse al historial.'}
                </p>
              </div>
            )}
          </section>


          {norma.cambios_automaticos?.length > 0 && (
            <section class="detail-section" id="detecciones">
              <div class="detail-section__heading">
                <p class="eyebrow eyebrow--red">DETECCIÓN AUTOMÁTICA</p>
                <h2>Cambios detectados por el monitor BOE</h2>
                <p class="section-description">
                  Estos registros los genera automáticamente el sistema a partir de las
                  nuevas versiones de bloques publicadas por la AEBOE y quedan pendientes
                  de revisión humana antes de integrarse en el historial jurídico curado.
                </p>
              </div>

              <div class="auto-changes">
                {norma.cambios_automaticos.map((cambio) => (
                  <article class="auto-change-card">
                    <div class="auto-change-card__top">
                      <div>
                        <span>{cambio.fecha_publicacion || cambio.detectado_el}</span>
                        <strong>{cambio.resumen}</strong>
                      </div>
                      <em>{cambio.estado_revision}</em>
                    </div>

                    {cambio.norma_modificadora_id && (
                      <p class="auto-modifier">
                        Norma modificadora: <strong>{cambio.norma_modificadora_id}</strong>
                      </p>
                    )}

                    <div class="auto-blocks">
                      {cambio.bloques.map((bloque) => (
                        <details>
                          <summary>{bloque.bloque_titulo}</summary>
                          <div class="before-after">
                            <div>
                              <span>Antes</span>
                              <pre>{bloque.antes || 'No existe una versión anterior en el bloque.'}</pre>
                            </div>
                            <div>
                              <span>Ahora</span>
                              <pre>{bloque.ahora || 'Texto no disponible.'}</pre>
                            </div>
                          </div>
                          {bloque.texto_truncado && (
                            <p class="truncation-note">
                              El bloque es muy extenso y se ha limitado su copia local. La
                              fuente oficial del BOE conserva el texto íntegro.
                            </p>
                          )}
                        </details>
                      ))}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}

          <section class="detail-section" id="fuentes">
            <div class="detail-section__heading">
              <p class="eyebrow">DOCUMENTACIÓN</p>
              <h2>Fuentes oficiales</h2>
            </div>

            <div class="official-sources">
              {norma.fuente === 'BOE' ? (
                <>
                  <a href={norma.url_oficial} target="_blank" rel="noreferrer">
                    <span>
                      <small>BOE</small>
                      <strong>Texto consolidado</strong>
                    </span>
                    <span aria-hidden="true">↗</span>
                  </a>

                  <a href={norma.url_publicacion} target="_blank" rel="noreferrer">
                    <span>
                      <small>BOE</small>
                      <strong>Publicación original</strong>
                    </span>
                    <span aria-hidden="true">↗</span>
                  </a>

                  <a href={norma.eli} target="_blank" rel="noreferrer">
                    <span>
                      <small>ELI</small>
                      <strong>Identificador Europeo de Legislación</strong>
                    </span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </>
              ) : (
                <>
                  <a href={norma.url_oficial} target="_blank" rel="noreferrer">
                    <span>
                      <small>{norma.fuente}</small>
                      <strong>{norma.fuente === 'BORM' ? 'Publicación oficial' : 'Documento o página oficial'}</strong>
                    </span>
                    <span aria-hidden="true">↗</span>
                  </a>

                  {norma.url_contexto && (
                    <a href={norma.url_contexto} target="_blank" rel="noreferrer">
                      <span>
                        <small>FUENTE COMPLEMENTARIA</small>
                        <strong>Contexto oficial</strong>
                      </span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </>
              )}
            </div>
          </section>

          <section class="detail-section" id="seguimiento">
            <div class="monitor-card">
              <div>
                <p class="eyebrow eyebrow--red">VIGILANCIA NORMATIVA</p>
                <h2>{norma.seguimiento}</h2>
                <p>
                  {norma.fuente === 'BOE'
                    ? 'Esta ficha está incluida en la vigilancia automática. El robot compara diariamente el índice de bloques de la legislación consolidada del BOE y conserva las versiones anterior y nueva cuando detecta cambios.'
                    : norma.fuente === 'BORM'
                      ? 'Esta ficha forma parte del ámbito de vigilancia del BORM. El sistema revisa cada nuevo boletín, identifica disposiciones potencialmente universitarias y las envía a revisión humana antes de alterar el catálogo jurídico.'
                      : 'El monitor UMU revisa la huella del documento o página oficial y explora páginas de normativa para detectar nuevas publicaciones. Los cambios técnicos se envían a revisión humana antes de alterar esta ficha.'}
                </p>
              </div>

              <div class="monitor-status monitor-status--active">
                <span>ACTIVA</span>
                <strong>
                  {norma.fuente === 'BOE'
                    ? 'Comprobación diaria del BOE'
                    : norma.fuente === 'BORM'
                      ? 'Revisión diaria del BORM'
                      : 'Revisión diaria de fuentes UMU'}
                </strong>
              </div>
            </div>
          </section>
        </div>
      </div>
    </main>

    <footer>
      <div class="container footer-grid">
        <div>
          <p class="footer-title">Observatorio Normativo Universitario</p>
          <p>
            Proyecto en desarrollo para facilitar el acceso y seguimiento de la normativa
            universitaria.
          </p>
        </div>

        <div class="footer-brand">
          <span>Consejo de Estudiantes</span>
          <img src="/assets/logo-ceum.png" alt="CEUM" />
        </div>
      </div>

      <div class="container footer-bottom">
        <span>Universidad de Murcia</span>
        <span>Fuentes oficiales · Verificación · Trazabilidad</span>
      </div>
    </footer>
  </body>
</html>
